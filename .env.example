# Armrest daemon settings (prefix ARMREST_; the pre-0.5.0 CJ_ names still work). Copy to .env and edit.

# --- Cloud relay (AWS API Gateway WebSocket URL from `sam deploy` output) ---
ARMREST_RELAY_WS_URL=wss://xxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
# Where the phone app is hosted (Cloudflare Pages). QR code points here.
ARMREST_PWA_BASE_URL=https://armrest-app.pages.dev

# --- LAN fallback server (serves /ws, /events, /api/command and the PWA) ---
ARMREST_LAN_HOST=0.0.0.0
ARMREST_LAN_PORT=8765
# Optional TLS (e.g. generated with mkcert) enables phone microphone over LAN.
# ARMREST_LAN_TLS_CERT=C:\certs\lan.pem
# ARMREST_LAN_TLS_KEY=C:\certs\lan-key.pem

# --- Microsoft Edge / CDP ---
# ARMREST_EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# ARMREST_EDGE_PROFILE_DIR=C:\Users\you\AppData\Local\Armrest\edge-profile
ARMREST_CDP_PORT=9222

# --- Speech-to-text ---
# auto = large-v3-turbo on an NVIDIA GPU, small on a CPU
ARMREST_STT_MODEL=auto
ARMREST_STT_DEVICE=auto
# Free-tier Groq Whisper fallback
# ARMREST_GROQ_API_KEY=gsk_...

# --- Router / VLM ---
# auto = Gemini when ARMREST_GEMINI_API_KEY is set (local model as backup), else local Ollama
ARMREST_ROUTER_PROVIDER=auto
ARMREST_OLLAMA_URL=http://127.0.0.1:11434
# auto = qwen2.5:7b on a GPU, phi4-mini on a CPU
ARMREST_OLLAMA_TEXT_MODEL=auto
ARMREST_OLLAMA_VLM_MODEL=qwen2.5vl:7b
# ARMREST_GEMINI_API_KEY=...

# --- Spoken replies ("Now playing X on YouTube Music") ---
# On by default; change the voice, style or switch it off from the phone (Settings). With no key
# below, free Microsoft Edge neural voices speak, and Windows' own voices work with no internet.
# ElevenLabs sounds best; its free plan gives ~10k characters a month and the daemon stops before
# that is used up (ARMREST_ELEVENLABS_MONTHLY_CHARS), then falls back to the free voices.
# ARMREST_ELEVENLABS_API_KEY=sk_...
# ARMREST_ELEVENLABS_MONTHLY_CHARS=9000

# --- Touchpad / keyboard from paired phones ---
# true: a paired phone can move the cursor and type (like sitting at your keyboard), so only
# pair people you trust. false: phones are limited to media and browser commands.
ARMREST_REMOTE_INPUT=true

# Opt-in crash reports: a scrubbed error report when the app crashes (no names, addresses or
# what you watch; see pc-daemon/crash_reports.py). Off by default.
ARMREST_CRASH_REPORTS=false
# Builder only: the Sentry DSN that installer\build.ps1 bakes into builds (public by design).
# ARMREST_CRASH_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# --- Misc ---
# ARMREST_TELEMETRY_DIR=C:\Users\you\AppData\Local\Armrest\telemetry
ARMREST_HUD_SCREEN_INDEX=0
ARMREST_LOG_LEVEL=INFO
